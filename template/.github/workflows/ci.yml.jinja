name: CI

on:
  pull_request:
    branches: [{{ default_branch }}]
  push:
    branches: [{{ default_branch }}]

permissions:
  contents: read

jobs:
  # The job name `check` is the required status check of the ruleset
  # (docs/harness/ruleset.json). Renaming it blocks every merge.
  check:
    runs-on: ubuntu-latest
    timeout-minutes: 20
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false
{%- set ctx = ["AGENTS.md"] + (["CLAUDE.md"] if use_claude else []) + ([".claude/rules/*.md"] if use_claude or use_copilot else []) + ([".github/copilot-instructions.md"] if use_copilot else []) %}
      - name: Context budget ({{ ctx | join(" + ") | replace("/*.md", "") }} <= 16000 bytes)
        run: |
          bytes=$(cat {{ ctx | join(" ") }} | wc -c)
          echo "context bytes: $bytes"
          test "$bytes" -le 16000
      # Runs on every change, documentation-only ones included: no `if:` here and no path filter on the workflow.
      - name: OpenSpec agent files (only {% if use_codex or use_copilot %}propose, archive, update and sync{% else %}the opsx commands propose, archive, update and sync{% endif %} stay)
        run: |
          bad=$({
            find .claude/skills -mindepth 1 -maxdepth 1 -name 'openspec-*'
            find .claude/commands/opsx -mindepth 1 ! -name propose.md ! -name archive.md ! -name update.md ! -name sync.md
{%- if use_codex or use_copilot %}
            find .agents/skills -mindepth 1 -maxdepth 1 -name 'openspec-*' ! -name openspec-propose ! -name openspec-archive-change ! -name openspec-update-change ! -name openspec-sync-specs
{%- endif %}
          } 2>/dev/null | sort || true)
          if [ -n "$bad" ]; then
            echo "These OpenSpec files were stripped and have come back (openspec update restores them). Delete them:"
            echo "$bad"
            exit 1
          fi
      # The first change adds the stack's setup, lint, typecheck, test and build steps here.
